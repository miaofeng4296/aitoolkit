{
  "framework": null,
  "buildCommand": null,
  "devCommand": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      }
    },
    {
      "src": "/api/remove-bg",
      "dest": "/api/remove-bg.py"
    },
    {
      "src": "/api/psd-parse",
      "dest": "/api/psd-parse.py"
    },
    {
      "src": "/api/text-rewrite",
      "dest": "/api/text-rewrite.py"
    },
    {
      "src": "/api/text-polish",
      "dest": "/api/text-polish.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "installCommand": "pip install -r requirements.txt"
}
