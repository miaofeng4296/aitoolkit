{
  "framework": null,
  "buildCommand": null,
  "devCommand": null,
  "routes": [
    {
      "src": "/api/remove-bg",
      "dest": "/api/remove-bg.py"
    },
    {
      "src": "/api/psd-parse",
      "dest": "/api/psd-parse.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "installCommand": "pip install -r requirements.txt",
  "build": {
    "environment": {
      "PYTHONPATH": "."
    }
  },
  "functions": {
    "api/remove-bg.py": {
      "runtime": "python3.9",
      "memorySize": 1024,
      "maxDuration": 30
    },
    "api/psd-parse.py": {
      "runtime": "python3.9",
      "memorySize": 1024,
      "maxDuration": 60
    }
  }
}
